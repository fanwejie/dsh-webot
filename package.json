{
  "name": "dsh-webot",
  "version": "1.0.0",
  "private": true,
  "description": "WeChat channel for DeepSeek Harness: bind WeChat, then drive the agent from your phone.",
  "type": "module",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "wechat",
    "weixin",
    "ilink",
    "channel",
    "plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanwejie/dsh-webot.git"
  },
  "homepage": "https://github.com/fanwejie/dsh-webot#readme",
  "bugs": {
    "url": "https://github.com/fanwejie/dsh-webot/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "README.en.md"
  ],
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT"
}
